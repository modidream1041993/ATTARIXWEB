{
  "framework": null,
  "buildCommand": "node site-build/build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/guide",
      "destination": "/ATTARIX-GUIDE"
    }
  ],
  "redirects": [
    {
      "source": "/ATTARIX",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ATTARIX-Setup.exe",
      "destination": "https://github.com/modidream1041993/ATTARIXWEB/releases/download/v3.1.0/Attarix_3.1.0_x64-setup.exe",
      "permanent": false
    },
    {
      "source": "/Attarix_2.3.0_x64-setup.exe",
      "destination": "https://github.com/modidream1041993/ATTARIXWEB/releases/download/v3.1.0/Attarix_3.1.0_x64-setup.exe",
      "permanent": false
    },
    {
      "source": "/developer",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "admin-state": false
    }
  }
}
