#!/bin/sh
# Refuses a commit that would put a binary into THIS repo's history.
#
# Enable (once per clone — hooks are never cloned):
#     git config core.hooksPath .githooks
#
# This is the repo where it already happened: on 2026-08-31 two 5 MB installers were
# uploaded through the GitHub web UI and are now permanent here. This repo is PUBLIC
# and is the deploy source for the website, so a binary committed here is downloadable
# by anyone — and an installer built before 2026-07-10 embeds a real merchant's
# database (the seed.db incident).
#
# ⚠️ This hook CANNOT have prevented that upload: the GitHub web UI commits on
# GitHub's servers, where no local hook runs. Closing that gap needs CI, which is
# NOT wired up yet — see RELEASE-PROCESS.md, "الحارس في CI". Until it is, the only
# thing covering web uploads is the rule: don't use them.
#
# The guard itself lives in the desktop project (accounting-app), deliberately as ONE
# copy — a second copy would drift from the first, which is the exact failure shape this
# project has been bitten by before. Two layouts are recognised: this repo checked out
# INSIDE accounting-app (the old `ATTARIX WEB/` folder: ../scripts), and a standalone
# clone BESIDE it (Desktop\attarix-web-site, since 2026-10-08: ../accounting-app/scripts).
# ATTARIX_BINARY_GUARD names the guard file explicitly, for when the accounting-app checkout is
# on a branch that does not carry it (a release worktree does). Set but missing still fails closed.
TOP="$(git rev-parse --show-toplevel)"
GUARD=""
for candidate in ${ATTARIX_BINARY_GUARD:+"$ATTARIX_BINARY_GUARD"} "$TOP/../scripts/check-no-binaries.mjs" "$TOP/../accounting-app/scripts/check-no-binaries.mjs"; do
  if [ -f "$candidate" ]; then GUARD="$candidate"; break; fi
done

if [ -z "$GUARD" ]; then
  echo "❌ pre-commit: the binary guard is missing. Looked at:"
  [ -n "$ATTARIX_BINARY_GUARD" ] && echo "     $ATTARIX_BINARY_GUARD (ATTARIX_BINARY_GUARD)"
  echo "     $TOP/../scripts/check-no-binaries.mjs"
  echo "     $TOP/../accounting-app/scripts/check-no-binaries.mjs"
  echo "   Clone accounting-app beside this repo (or this repo inside it) — fail closed"
  echo "   rather than let an installer through silently."
  exit 1
fi

exec node "$GUARD" --staged
